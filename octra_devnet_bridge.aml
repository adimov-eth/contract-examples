// OctraDevnetBridge — our own clone of Octra-Labs's BRIDGE_VAULT v3.1.0
// for the pbridge testbed. 19-method ABI matches the production deployment
// at oct5MrNfjiX... (mainnet) and octBpYDyxx... (devnet) one-for-one, so
// the existing bridge.html / pbridge.html call patterns work unchanged when
// pointed at this address.
//
// Trust model: caller-equality. The Octra chain protocol's Ed25519 envelope
// signature on every tx is the auth primitive — `unlock_trusted` only checks
// `caller == self.unlock_operator`. AML has no in-VM signature opcode, so
// the off-chain signer service running on a separate wallet is the model.
//
// Differences from production:
// - Daily caps and version string updatable via owner methods (production
//   has admin-mutable caps too; we expose them similarly).
// - We accept any value above MIN_LOCK_RAW; production enforces the same.
//
// Out of scope: anything beyond the 19-method ABI surface. If we need more
// (e.g. shielded balances, FHE), use OETHVaultLite as the reference; this
// contract is intentionally minimal so the testbed mirrors the production
// surface exactly.

contract OctraDevnetBridge {

  const VERSION = "1.0.0-devnet"
  const MIN_LOCK_RAW = 10000000          // 10 OCT, matches production v3.1.0 floor
  const MAX_LOCK_RAW = 1000000000        // 1000 OCT per-lock soft ceiling
  const EPOCHS_PER_DAY = 8640
  const INITIAL_DAILY_LOCK_CAP = 10000000000   // 10 000 OCT/day
  const INITIAL_DAILY_UNLOCK_CAP = 10000000000

  state {
    owner: address
    guardian: address
    unlock_operator: address
    paused: int

    total_locked: int
    total_unlocked: int
    lock_nonce: int
    unlock_count: int

    // Per-lock record. We keep parallel maps (rather than a struct) because
    // the production view `get_lock_info(nonce)` returns separate fields and
    // we want one read per field to mirror that.
    lock_eth_recipients: map[int]string
    lock_amounts: map[int]int
    lock_octra_senders: map[int]address
    lock_epochs: map[int]int

    // Replay protection: each Ethereum-side burn produces a unique 32-byte
    // burn id (sha256 hash of the burn preimage); we mark each as processed.
    processed_unlocks: map[string]int

    // Daily caps for lock and unlock. Day boundary = epoch / EPOCHS_PER_DAY.
    daily_lock_cap: int
    daily_unlock_cap: int
    daily_locked: int
    last_lock_day: int
    daily_unlocked: int
    last_unlock_day: int

    // Was this contract initialized via init_defaults? Mirrors OETHVaultLite.
    initialized: int
  }

  event Locked(sender: address, eth_recipient: string, amount: int, nonce: int)
  event Unlocked(recipient: address, amount: int, burn_id: string, count: int)
  event Paused(by: address)
  event Unpaused(by: address)
  event OperatorChanged(role: string, old_op: address, new_op: address)
  event OwnershipTransferred(old_owner: address, new_owner: address)
  event GuardianChanged(old_guardian: address, new_guardian: address)
  event DailyCapsUpdated(lock_cap: int, unlock_cap: int)

  constructor(guardian_addr: address, unlock_op: address) {
    require(is_address(guardian_addr), "invalid guardian")
    require(is_address(unlock_op), "invalid unlock operator")
    self.owner = caller
    self.guardian = guardian_addr
    self.unlock_operator = unlock_op
    self.paused = 0
    self.initialized = 0
  }

  fn init_defaults(): bool {
    only_owner()
    require(self.initialized == 0, "already initialized")
    self.daily_lock_cap = INITIAL_DAILY_LOCK_CAP
    self.daily_unlock_cap = INITIAL_DAILY_UNLOCK_CAP
    self.last_lock_day = epoch / EPOCHS_PER_DAY
    self.last_unlock_day = epoch / EPOCHS_PER_DAY
    self.initialized = 1
    return true
  }

  // ---- public entrypoints ----

  // O -> E: user attaches OCT, names the Ethereum recipient.
  // Off-chain signer watches Locked events and produces verifyAndMint
  // calldata that mints wOCT on Sepolia.
  fn lock_to_eth(eth_recipient: string): int {
    not_paused()
    require(value >= MIN_LOCK_RAW, "below minimum lock")
    require(value <= MAX_LOCK_RAW, "above maximum lock")
    validate_eth_address(eth_recipient)

    reset_daily_lock()
    require(self.daily_locked + value <= self.daily_lock_cap, "daily lock cap")

    self.lock_nonce += 1
    let n = self.lock_nonce
    self.lock_eth_recipients[n] = eth_recipient
    self.lock_amounts[n] = value
    self.lock_octra_senders[n] = caller
    self.lock_epochs[n] = epoch

    self.total_locked += value
    self.daily_locked += value

    emit Locked(caller, eth_recipient, value, n)
    return n
  }

  // E -> O: relayer-submitted credit. Off-chain signer watches Sepolia
  // BurnInitiated events and submits this with the burn id as the
  // idempotency key.
  fn unlock_trusted(recipient: address, amount: int, burn_id: string): bool {
    only_unlock_operator()
    not_paused()
    require(is_address(recipient), "bad recipient")
    require(amount > 0, "zero amount")
    require(len(burn_id) == 66, "bad burn_id")
    require(self.processed_unlocks[burn_id] == 0, "replay")

    reset_daily_unlock()
    require(self.daily_unlocked + amount <= self.daily_unlock_cap, "daily unlock cap")

    self.processed_unlocks[burn_id] = 1
    self.unlock_count += 1
    self.total_unlocked += amount
    self.daily_unlocked += amount

    transfer(recipient, amount)

    emit Unlocked(recipient, amount, burn_id, self.unlock_count)
    return true
  }

  // ---- admin (owner / guardian) ----

  fn pause(): bool {
    only_guardian_or_owner()
    self.paused = 1
    emit Paused(caller)
    return true
  }

  fn unpause(): bool {
    only_owner()
    self.paused = 0
    emit Unpaused(caller)
    return true
  }

  fn set_unlock_operator(op: address): bool {
    only_owner()
    require(is_address(op), "bad op")
    let old = self.unlock_operator
    self.unlock_operator = op
    emit OperatorChanged("unlock_op", old, op)
    return true
  }

  fn update_guardian(g: address): bool {
    only_owner()
    require(is_address(g), "bad guardian")
    let old = self.guardian
    self.guardian = g
    emit GuardianChanged(old, g)
    return true
  }

  fn transfer_ownership(new_owner: address): bool {
    only_owner()
    require(is_address(new_owner), "bad new owner")
    let old = self.owner
    self.owner = new_owner
    emit OwnershipTransferred(old, new_owner)
    return true
  }

  fn set_daily_caps(lock_cap: int, unlock_cap: int): bool {
    only_owner()
    require(lock_cap >= 0, "neg lock cap")
    require(unlock_cap >= 0, "neg unlock cap")
    self.daily_lock_cap = lock_cap
    self.daily_unlock_cap = unlock_cap
    emit DailyCapsUpdated(lock_cap, unlock_cap)
    return true
  }

  // ---- view methods (mirroring production v3.1.0 ABI) ----

  view fn version(): string {
    return VERSION
  }

  view fn is_paused(): int {
    return self.paused
  }

  view fn get_total_locked(): int {
    return self.total_locked
  }

  view fn get_total_unlocked(): int {
    return self.total_unlocked
  }

  view fn get_lock_nonce(): int {
    return self.lock_nonce
  }

  view fn get_unlock_count(): int {
    return self.unlock_count
  }

  view fn get_unlock_operator(): address {
    return self.unlock_operator
  }

  view fn is_unlock_processed(burn_id: string): int {
    return self.processed_unlocks[burn_id]
  }

  // Returns a colon-joined record so the result fits the chain's view ABI;
  // signerd parses it. Production exposes a struct here but we keep it
  // string-shaped for portability — tests confirm the same data is recovered.
  view fn get_lock_info(nonce: int): string {
    if nonce < 1 {
      return "missing"
    }
    if nonce > self.lock_nonce {
      return "missing"
    }
    let r = self.lock_eth_recipients[nonce]
    let a = self.lock_amounts[nonce]
    let e = self.lock_epochs[nonce]
    return r + ":" + to_string(a) + ":" + to_string(e)
  }

  view fn daily_lock_remaining(): int {
    let today = epoch / EPOCHS_PER_DAY
    if today != self.last_lock_day {
      return self.daily_lock_cap
    }
    return self.daily_lock_cap - self.daily_locked
  }

  view fn daily_unlock_remaining(): int {
    let today = epoch / EPOCHS_PER_DAY
    if today != self.last_unlock_day {
      return self.daily_unlock_cap
    }
    return self.daily_unlock_cap - self.daily_unlocked
  }

  view fn supply_invariant(): int {
    // Net OCT held by the contract at any moment is total_locked - total_unlocked.
    // Production exposes this as a sanity-check view; we mirror the surface
    // and return 1 if the bookkeeping is non-negative (lock_nonce monotonic +
    // bounded daily caps make underflow unreachable, but checking is cheap).
    if self.total_locked >= self.total_unlocked {
      return 1
    }
    return 0
  }

  // ---- private helpers ----

  private fn only_owner() {
    require(caller == self.owner, "not owner")
  }

  private fn only_guardian_or_owner() {
    // AML has no `or`/`||` operator in deployed-production AML; structure as
    // an early-return when either role matches.
    if caller == self.guardian {
      return
    }
    require(caller == self.owner, "not guardian or owner")
  }

  private fn only_unlock_operator() {
    require(caller == self.unlock_operator, "not unlock operator")
  }

  private fn not_paused() {
    require(self.paused == 0, "bridge paused")
  }

  private fn reset_daily_lock() {
    let today = epoch / EPOCHS_PER_DAY
    if today != self.last_lock_day {
      self.daily_locked = 0
      self.last_lock_day = today
    }
  }

  private fn reset_daily_unlock() {
    let today = epoch / EPOCHS_PER_DAY
    if today != self.last_unlock_day {
      self.daily_unlocked = 0
      self.last_unlock_day = today
    }
  }

  private fn validate_eth_address(addr: string) {
    require(len(addr) == 42, "eth addr len")
    require(substr(addr, 0, 2) == "0x", "eth addr prefix")
    require(is_hex(substr(addr, 2, 40)), "eth addr hex")
  }
}
